{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "project_status": {
      "type": "enumeration",
      "required": false,
      "default": "development",
      "enum": [
        "development",
        "finished",
        "planning"
      ]
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "type": {
      "type": "string"
    },
    "project_tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "projects"
    },
    "tools": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tool.tool"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "component.overview",
        "component.challenge-solution",
        "component.key-features"
      ]
    },
    "project_post": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project-post.project-post",
      "mappedBy": "project"
    }
  }
}
