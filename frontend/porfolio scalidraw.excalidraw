    },
    {
      "id": "M0cBPjGa2jD1wK6ObMI7c",
      "type": "text",
      "x": 624.7813200298032,
      "y": 1833.6486418536508,
      "width": 308.9113538132901,
      "height": 68.9954898082059,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "alS",
      "roundness": null,
      "seed": 1295312051,
      "version": 1497,
      "versionNonce": 467140307,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768202127351,
      "link": null,
      "locked": false,
      "text": "In this high-stakes aviation environment, I provided critical value by ensuring\noperational safety and delivering exceptional service to international\npassengers. This experience was foundational in developing my professional soft\nskills, specifically in crisis management and cross-functional team collaboration\nunder pressure. I gained a unique perspective on user-centric service and active\nlistening, which I now apply to understanding and solving complex technical\nproblems for my software clients.",
      "fontSize": 7.885198835223532,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In this high-stakes aviation environment, I provided critical value by ensuring operational safety and delivering exceptional service to international passengers. This experience was foundational in developing my professional soft skills, specifically in crisis management and cross-functional team collaboration under pressure. I gained a unique perspective on user-centric service and active listening, which I now apply to understanding and solving complex technical problems for my software clients.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "W0bM9iqLgaQE49Arqd9NF",
      "type": "text",
      "x": 621.6781512589897,
      "y": 1587.4848130047437,
      "width": 308.9113538132901,
      "height": 59.13899126417649,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "alU",
      "roundness": null,
      "seed": 197363731,
      "version": 1719,
      "versionNonce": 347516019,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768202127351,
      "link": null,
      "locked": false,
      "text": "As a Full Stack Developer, I deliver end-to-end digital solutions by aligning\nbusiness requirements with robust technical execution. I specialize in building\nscalable web applications using TypeScript, React.js, and Laravel, ensuring high\nperformance through optimized database design and RESTful API integration.\nThis role has allowed me to master the application of SOLID principles and\nOOP patterns, producing clean and maintainable code for diverse client needs.",
      "fontSize": 7.885198835223532,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As a Full Stack Developer, I deliver end-to-end digital solutions by aligning business requirements with robust technical execution. I specialize in building scalable web applications using TypeScript, React.js, and Laravel, ensuring high performance through optimized database design and RESTful API integration. This role has allowed me to master the application of SOLID principles and OOP patterns, producing clean and maintainable code for diverse client needs.",
      "autoResize": false,
      "lineHeight": 1.25
    },
