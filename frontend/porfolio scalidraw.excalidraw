    {
      "id": "QpgRPboNI3h9nM6aRysTv",
      "type": "text",
      "x": 623.6639425088023,
      "y": 1812.6749377929116,
      "width": 175.894672062801,
      "height": 9.856498544029415,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
